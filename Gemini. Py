

*Project Structure:*

*1. `app.py` - Main Code (Itha copy pannunga)*
import streamlit as st
import google.generativeai as genai

Gemini API Key Setup
genai.configure(api_key="YOUR_GEMINI_API_KEY")

st.set_page_config(page_title="EdGenie - AI Learning Assistant")
st.title("🧞 EdGenie: Google Gemini Learning Assistant")
st.write("Unakku etha doubt irunthalum ketukalam!")

Chat History
if "messages" not in st.session_state:
    st.session_state.messages = []

for msg in st.session_state.messages:
    st.chat_message(msg["role"]).write(msg["content"])

User Input
if prompt := st.chat_input("Enna doubt? Ex: Explain Photosynthesis"):
    st.session_state.messages.append({"role": "user", "content": prompt})
    st.chat_message("user").write(prompt)

    # Gemini Response
    model = genai.GenerativeModel("gemini-1.5-flash")
    response = model.generate_content(f"You are EdGenie, a friendly learning assistant. Explain simply: {prompt}")
    
    answer = response.text
    st.session_state.messages.append({"role": "assistant", "content": answer})
    st.chat_message("assistant").write(answer)
